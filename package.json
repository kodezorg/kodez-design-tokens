{
  "name": "@kodez/design-tokens",
  "version": "1.5.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/tokens.css": "./dist/tokens.css",
    "./dist/tailwind-v4.css": "./dist/tailwind-v4.css"
  },
  "files": [
    "dist",
    "skills"
  ],
  "publishConfig": {
    "registry": "https://pkgs.dev.azure.com/kodez/kodez-connect/_packaging/kodez-connect-packages/npm/registry/"
  },
  "scripts": {
    "build": "tsup && node scripts/generate-css.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-themes": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^8.6.18",
    "tailwind-merge": "^3.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0"
  }
}
