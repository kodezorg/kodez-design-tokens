{
  "name": "@kodez/design-tokens",
  "version": "1.7.3",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/tokens.css": "./dist/tokens.css",
    "./dist/tailwind-v4.css": "./dist/tailwind-v4.css",
    "./eslint-plugin": {
      "types": "./dist/eslint-plugin.d.ts",
      "import": "./dist/eslint-plugin.js",
      "require": "./dist/eslint-plugin.cjs"
    }
  },
  "files": [
    "dist",
    "skills",
    ".changeset"
  ],
  "publishConfig": {
    "registry": "https://pkgs.dev.azure.com/kodez/kodez-connect/_packaging/kodez-connect-packages/npm/registry/"
  },
  "scripts": {
    "build": "tsup && node scripts/generate-css.mjs && node scripts/generate-w3c-tokens.mjs && node scripts/generate-css-data.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky",
    "validate": "node scripts/validate-parity.mjs && node scripts/validate-contrast.mjs && node scripts/validate-build.mjs",
    "validate:parity": "node scripts/validate-parity.mjs",
    "validate:contrast": "node scripts/validate-contrast.mjs",
    "validate:build": "node scripts/validate-build.mjs",
    "gen:w3c": "node scripts/generate-w3c-tokens.mjs",
    "gen:css-data": "node scripts/generate-css-data.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "npm run typecheck -- --noEmit"
    ]
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-themes": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "clsx": "^2.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^8.6.18",
    "tailwind-merge": "^3.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0"
  }
}
