{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "declaration": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "esModuleInterop": true
  },
  "include": ["src/**/*", "stories", ".storybook", "tsup.config.ts", "scripts"],
  "exclude": ["src/toekns-dark-v2.ts", "src/toekns-light-v2.ts"]
}
